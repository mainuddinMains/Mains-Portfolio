# Copy to .env.local and fill in. Never commit real secrets.
# The app runs without these: it falls back to placeholder content.

# --- Public (exposed to the browser; not secret) ---
# From https://www.sanity.io/manage → your project
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-10-01
# Canonical site URL, used for metadata (e.g. https://your-domain.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only secrets ---
# Only needed if the dataset is private. Create a "Viewer" token in sanity.io/manage → API.
SANITY_API_READ_TOKEN=
# Shared secret for the Sanity webhook → /api/revalidate. Generate with: openssl rand -hex 32
SANITY_REVALIDATE_SECRET=
